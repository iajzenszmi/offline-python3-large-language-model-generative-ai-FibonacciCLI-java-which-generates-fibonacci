public class FibonacciCLI {

    public static void main(String[] args) {
        try {
            int count = 25;
            for (int i = 0; i < count; i++) {
                System.out.println(fibonacci(i));
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private static long fibonacci(int n) throws IllegalArgumentException {
        if (n < 0) {
            throw new IllegalArgumentException("Input must be a non-negative integer.");
        }
        if (n <= 1) {
            return n;
        }
        long a = 0, b = 1, temp;
        for (int i = 2; i <= n; i++) {
            temp = a + b;
            a = b;
            b = temp;
        }
        return b;
    }
}
